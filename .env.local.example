# Copy this file to .env.local for local development, and set the same two
# values in Vercel (Project -> Settings -> Environment Variables) for the
# deployed site. Both are safe to expose to the browser (that's what
# NEXT_PUBLIC_ means) -- Supabase's anon key is meant to be public, access
# is enforced by the RLS policy in supabase/schema.sql, not by keeping this
# key secret.
#
# Get these from: Supabase dashboard -> your project -> Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Leave all three unset to run the app exactly as before -- localStorage
# only, one browser at a time, no Supabase project required.

# --- Real background push notifications (web + phone) ---
# Public half of the VAPID key pair used by the browser's Push API. Safe to
# expose (that's what NEXT_PUBLIC_ means). The matching private half is set
# as a Supabase Edge Function secret instead (VAPID_PRIVATE_KEY), never here.
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
